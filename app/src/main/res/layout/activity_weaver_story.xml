<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weaver Story"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="20dp"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="
Ilkal and Molakalmuru sarees are famous traditional handloom sarees of Karnataka.

These sarees are carefully woven by skilled weavers using silk and cotton materials. Each saree reflects Indian culture, craftsmanship, and heritage.

Namma Vastra helps local weavers understand modern fashion trends and connect directly with customers.

This platform supports handloom artists by promoting their products digitally.
"
            android:textSize="18sp"
            android:paddingTop="20dp"/>

    </LinearLayout>

</ScrollView>